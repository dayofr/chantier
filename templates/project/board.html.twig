{% extends 'layout.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}{{ 'board.title'|trans }} · {{ project.name }} · {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('portfolio') }}" class="hover:text-on-surface">{{ 'nav.portfolio'|trans }}</a>
    <span class="icon text-[16px] text-outline">chevron_right</span>
    <a href="{{ path('project_show', {key: project.key}) }}" class="truncate hover:text-on-surface">{{ project.name }}</a>
    <span class="icon text-[16px] text-outline">chevron_right</span>
    <span class="font-medium text-on-surface">{{ 'board.title'|trans }}</span>
{% endblock %}

{% block header %}
    {% set s = ticket_stats(filtered) %}
    {% include 'project/_header.html.twig' with {title: project.name ~ ' · ' ~ 'board.title'|trans} %}

    <div class="flex flex-wrap items-center gap-3">
        <div class="card flex items-center gap-4 px-4 py-2.5">
            <span class="text-label-md font-semibold text-primary">{{ 'board.completed'|trans({progress: s.progress}) }}</span>
            <div class="w-40">{{ ui.progress(s.progress) }}</div>
            <span class="font-mono text-label-md text-on-surface-variant">{{ 'board.tickets_done'|trans({done: s.done, total: s.total}) }}</span>
        </div>
    </div>

    {% include 'board/_epic_filter.html.twig' with {board_route: 'project_board', board_params: {key: project.key}} %}
{% endblock %}

{% block content %}
    {% include 'board/_columns.html.twig' %}
{% endblock %}

{% extends 'layout.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}{{ project.name }} · {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('portfolio') }}" class="hover:text-on-surface">{{ 'nav.portfolio'|trans }}</a>
    <span class="icon text-[16px] text-outline">chevron_right</span>
    <span class="truncate font-medium text-on-surface">{{ project.name }}</span>
{% endblock %}

{% block header %}
    {% set s = ticket_stats(project.tickets) %}
    {% include 'project/_header.html.twig' with {title: project.name, subtitle: project.description} %}

    <section class="grid grid-cols-2 gap-4 xl:grid-cols-4">
        <div class="card flex flex-col gap-2 p-4">
            <div class="flex items-center justify-between text-label-md font-medium text-on-surface-variant">{{ 'project.kpi.progress'|trans }}<span class="icon text-[18px] text-primary">donut_large</span></div>
            <div class="font-display text-headline-lg font-bold">{{ s.progress }}%</div>
            {{ ui.progress(s.progress) }}
            <div class="text-body-sm text-on-surface-variant">{{ 'project.kpi.progress_hint'|trans({done: s.done, total: s.total}) }}</div>
        </div>
        {{ ui.kpi('project.kpi.remaining'|trans, s.remaining, 'project.kpi.remaining_hint'|trans, 'pending_actions') }}
        {{ ui.kpi('project.kpi.in_progress'|trans, s.inProgress, 'project.kpi.in_progress_hint'|trans({count: s.inReview}), 'motion_play') }}
        {{ ui.kpi('project.kpi.blocked'|trans, s.blocked, 'project.kpi.blocked_hint'|trans, 'block', s.blocked > 0 ? 'blocked') }}
    </section>
{% endblock %}

{% block content %}
<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <section class="flex min-w-0 flex-col gap-4">
        <div class="flex items-center gap-3">
            <h2 class="font-display text-headline-md font-semibold">{{ 'project.initiatives'|trans }}</h2>
            {{ ui.chip('project.initiatives_count'|trans({count: project.initiatives|length})) }}
        </div>

        {% for initiative in project.initiatives %}
            {% set tickets = initiative.epics|reduce((carry, e) => carry|merge(e.tickets), []) %}
            {% set is = ticket_stats(tickets) %}
            <details class="card group/init overflow-hidden" {{ initiative.status.value != 'done' and is.progress < 100 ? 'open' }}>
                <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-2 p-5 hover:bg-surface-low/60">
                    <span class="icon text-outline transition-transform group-open/init:rotate-90">chevron_right</span>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="key">{{ initiative.key }}</span>
                            {{ ui.status(initiative.status) }}
                            {{ ui.risk(initiative.risk) }}
                        </div>
                        <h3 class="mt-1 font-display text-headline-sm font-semibold"><a href="{{ path('initiative_show', {key: initiative.key}) }}" class="underline decoration-outline-variant underline-offset-4 hover:text-primary hover:decoration-primary">{{ initiative.title }}</a></h3>
                        <p class="mt-0.5 text-body-sm text-on-surface-variant">
                            {{ 'project.epics_count'|trans({count: initiative.epics|length}) }} · {{ 'project.tickets_done'|trans({done: is.done, total: is.total}) }}
                        </p>
                    </div>
                    <div class="w-full sm:w-48">
                        <div class="mb-1 flex justify-between text-label-md font-medium"><span>{{ 'project.kpi.progress'|trans }}</span><span class="font-mono">{{ is.progress }}%</span></div>
                        {{ ui.progress(is.progress) }}
                    </div>
                    <a href="{{ path('initiative_show', {key: initiative.key}) }}"
                       class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-primary/30 bg-primary-soft px-3 py-1.5 text-label-md font-semibold text-primary hover:border-primary/60">
                        <span class="icon text-[17px]">view_kanban</span>{{ 'project.open_initiative'|trans }}
                    </a>
                </summary>

                <div class="flex flex-col gap-3 border-t border-outline-variant/40 bg-surface-low/40 p-4 sm:p-5">
                    {% if initiative.description %}
                        <div class="prose-md text-on-surface-variant">{{ initiative.description|markdown }}</div>
                    {% endif %}
                    {% for epic in initiative.epics %}
                        {% set es = ticket_stats(epic.tickets) %}
                        <details class="card group/epic" {{ epic.status.value not in ['done', 'cancelled'] and es.progress < 100 ? 'open' }}>
                            <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                                <span class="icon text-[18px] text-outline transition-transform group-open/epic:rotate-90">chevron_right</span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="key">{{ epic.key }}</span>
                                        <a href="{{ path('initiative_show', {key: initiative.key, epic: epic.key}) }}" class="font-semibold underline decoration-outline-variant underline-offset-4 hover:text-primary hover:decoration-primary">{{ epic.title }}</a>
                                        {{ ui.status(epic.status) }}
                                    </div>
                                    <p class="mt-0.5 flex flex-wrap gap-x-3 text-label-md text-on-surface-variant">
                                        <span>{{ 'project.tickets_done'|trans({done: es.done, total: es.total}) }}</span>
                                        {% if epic.targetDate %}<span class="flex items-center gap-1"><span class="icon text-[14px]">event</span>{{ 'project.target'|trans({date: epic.targetDate|format_date('medium')}) }}</span>{% endif %}
                                        {% if es.blocked %}<span class="text-blocked">{{ es.blocked }} {{ 'project.kpi.blocked'|trans|lower }}</span>{% endif %}
                                    </p>
                                </div>
                                <div class="flex w-full items-center gap-2 sm:w-40">
                                    {{ ui.progress(es.progress) }}
                                    <span class="w-9 text-right font-mono text-label-md">{{ es.progress }}%</span>
                                </div>
                            </summary>
                            <div class="border-t border-outline-variant/40 px-1 py-1">
                                {% if epic.description %}
                                    <div class="prose-md px-3 py-2 text-body-sm text-on-surface-variant">{{ epic.description|markdown }}</div>
                                {% endif %}
                                {% for ticket in epic.tickets %}
                                    {{ ui.ticket_row(ticket) }}
                                {% else %}
                                    <p class="px-3 py-2 text-body-sm text-outline">{{ 'project.no_tickets'|trans }}</p>
                                {% endfor %}
                            </div>
                        </details>
                    {% else %}
                        <p class="text-body-sm text-outline">{{ 'project.no_epics'|trans }}</p>
                    {% endfor %}
                </div>
            </details>
        {% else %}
            {{ ui.empty('project.no_initiatives'|trans, null, 'account_tree') }}
        {% endfor %}

        {% set all_orphans = project.tickets|filter(t => t.epic is null) %}
        {% if all_orphans|length %}
            <section class="card p-5">
                <h2 class="font-display text-headline-sm font-semibold">{{ 'project.orphans.title'|trans }}</h2>
                <p class="mb-2 text-body-sm text-on-surface-variant">{{ 'project.orphans.hint'|trans }}</p>
                {% for ticket in all_orphans %}{{ ui.ticket_row(ticket) }}{% endfor %}
            </section>
        {% endif %}
    </section>

    <aside class="flex flex-col gap-4">
        <section class="card p-5">
            {% set serious = alerts|filter(a => a.severity != 'low') %}
            {% set minor = alerts|filter(a => a.severity == 'low') %}
            <h2 class="flex items-center gap-2 font-display text-headline-sm font-semibold">
                <span class="icon text-primary">notifications_active</span>{{ 'project.alerts.title'|trans }}
                {% if serious|length %}<span class="ml-auto">{{ ui.chip(serious|length, serious|filter(a => a.severity == 'high')|length ? 'blocked' : 'progress') }}</span>{% endif %}
            </h2>
            {% if alerts is empty %}
                <p class="mt-3 flex items-center gap-2 text-body-sm text-on-surface-variant"><span class="icon text-[18px] text-done">check_circle</span>{{ 'project.alerts.none'|trans }}</p>
            {% else %}
                {% if serious|length %}
                    <ul class="mt-3 flex flex-col gap-2">
                        {% for alert in serious %}
                            {% include 'project/_alert.html.twig' %}
                        {% endfor %}
                    </ul>
                {% endif %}
                {# Alertes mineures regroupées par type, pour ne pas noyer les importantes. #}
                {% for type in ['bottleneck', 'stale', 'blocked', 'orphan'] %}
                    {% set group = minor|filter(a => a.type == type) %}
                    {% if group|length %}
                        <div class="mt-3 rounded-lg border border-outline-variant/60 bg-surface-low px-3 py-2">
                            <p class="flex items-center gap-1.5 text-label-md font-semibold uppercase tracking-wide text-on-surface-variant">
                                <span class="icon text-[16px]">{{ {bottleneck: 'call_split', stale: 'hourglass_empty', blocked: 'block', orphan: 'link_off'}[type] }}</span>
                                {{ ('project.alerts.type.' ~ type)|trans }} · {{ group|length }}
                            </p>
                            <ul class="mt-1 flex flex-col">
                                {% for alert in group %}
                                    <li class="flex min-w-0 items-baseline gap-2 text-body-sm">
                                        <a href="{{ path('ticket_show', {key: alert.ticket.key}) }}" class="min-w-0 truncate hover:underline" title="{{ alert.ticket.title }}"><span class="key">{{ alert.ticket.key }}</span> {{ alert.ticket.title }}</a>
                                        {% if alert.blockers is defined and alert.blockers|length %}
                                            <span class="shrink-0 font-mono text-label-sm text-outline">← {{ alert.blockers|map(b => b.key)|join(', ') }}</span>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                {% endfor %}
                <p class="mt-3 text-label-md text-outline">{{ 'project.alerts.stale_rule'|trans({hours: staleHours}) }}</p>
            {% endif %}
        </section>
    </aside>
</div>
{% endblock %}

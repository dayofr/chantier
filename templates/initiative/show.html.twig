{% extends 'layout.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}{{ initiative.title }} · {{ project.name }} · {{ parent() }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('portfolio') }}" class="hidden hover:text-on-surface sm:inline">{{ 'nav.portfolio'|trans }}</a>
    <span class="icon hidden text-[16px] text-outline sm:inline">chevron_right</span>
    <a href="{{ path('project_show', {key: project.key}) }}" class="max-w-40 truncate hover:text-on-surface">{{ project.name }}</a>
    <span class="icon text-[16px] text-outline">chevron_right</span>
    <span class="truncate font-medium text-on-surface">{{ initiative.title }}</span>
{% endblock %}

{% block header %}
    {% set all = ticket_stats(epics|reduce((carry, e) => carry|merge(e.tickets), [])) %}
    {% set s = ticket_stats(filtered) %}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 max-w-4xl">
            <div class="flex flex-wrap items-center gap-2">
                <span class="key">{{ initiative.key }}</span>
                {{ ui.status(initiative.status) }}
                {{ ui.risk(initiative.risk) }}
            </div>
            <h1 class="mt-1 font-display text-headline-lg font-bold">{{ initiative.title }}</h1>
            {% if initiative.description %}
                <div class="prose-md mt-2 text-on-surface-variant">{{ initiative.description|markdown }}</div>
            {% endif %}
        </div>
        <div class="card flex w-full flex-col gap-2 p-4 sm:w-64">
            <div class="flex items-center justify-between text-label-md font-medium text-on-surface-variant">{{ 'project.kpi.progress'|trans }}<span class="font-mono text-on-surface">{{ all.progress }}%</span></div>
            {{ ui.progress(all.progress) }}
            <div class="text-body-sm text-on-surface-variant">
                {{ 'project.epics_count'|trans({count: epics|length}) }} · {{ 'project.tickets_done'|trans({done: all.done, total: all.total}) }}
            </div>
        </div>
    </div>

    <section class="card p-5" id="decisions">
        <h2 class="flex items-center gap-2 font-display text-headline-sm font-semibold">
            <span class="icon text-review">gavel</span>{{ 'initiative.decisions'|trans }}
            {% if decisions|length %}{{ ui.chip(decisions|length, 'review') }}{% endif %}
            {% if currentEpic %}<span class="font-sans text-label-md font-normal text-on-surface-variant">· {{ currentEpic }}</span>{% endif %}
        </h2>
        {% if decisions is empty %}
            <p class="mt-2 text-body-sm text-outline">{{ 'initiative.no_decisions'|trans }}</p>
        {% else %}
            {% set shown = 3 %}
            <ol class="mt-3 flex flex-col gap-2">
                {% for decision in decisions|slice(0, shown) %}{{ _self.decision(decision) }}{% endfor %}
            </ol>
            {% if decisions|length > shown %}
                <details class="group/more mt-2">
                    <summary class="flex cursor-pointer list-none items-center gap-1 text-label-md font-medium text-primary hover:underline">
                        <span class="icon text-[18px] transition-transform group-open/more:rotate-180">expand_more</span>
                        <span class="group-open/more:hidden">{{ 'initiative.more_decisions'|trans({count: decisions|length - shown}) }}</span>
                        <span class="hidden group-open/more:inline">{{ 'initiative.less_decisions'|trans }}</span>
                    </summary>
                    <ol class="mt-2 flex flex-col gap-2">
                        {% for decision in decisions|slice(shown) %}{{ _self.decision(decision) }}{% endfor %}
                    </ol>
                </details>
            {% endif %}
        {% endif %}
    </section>

    {% include 'board/_epic_filter.html.twig' with {board_route: 'initiative_show', board_params: {key: initiative.key}} %}

    <div class="card flex w-fit items-center gap-4 px-4 py-2.5">
        <span class="text-label-md font-semibold text-primary">{{ 'board.completed'|trans({progress: s.progress}) }}</span>
        <div class="w-40">{{ ui.progress(s.progress) }}</div>
        <span class="font-mono text-label-md text-on-surface-variant">{{ 'board.tickets_done'|trans({done: s.done, total: s.total}) }}</span>
    </div>
{% endblock %}

{% block content %}
    {% include 'board/_columns.html.twig' %}
{% endblock %}

{% macro decision(decision) %}
    <li class="flex gap-3 rounded-lg border border-review/25 bg-review-soft/40 px-3 py-2">
        <div class="min-w-0 flex-1">
            <div class="prose-md text-body-sm">{{ decision.message|markdown }}</div>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 text-label-md text-outline">
                {% if decision.ticket %}
                    <a href="{{ path('ticket_show', {key: decision.ticket.key}) }}" class="key hover:text-primary" title="{{ decision.ticket.title }}">{{ decision.ticket.key }}</a>
                {% else %}
                    <span class="key">{{ decision.subjectKey }}</span>
                {% endif %}
                <time datetime="{{ decision.createdAt|date('c') }}" title="{{ decision.createdAt|format_datetime('medium', 'short') }}">{{ decision.createdAt|format_date('medium') }}</time>
                {% if decision.sessionId %}
                    <a href="{{ path('session_show', {sessionId: decision.sessionId}) }}" class="font-mono hover:text-primary" title="{{ 'activity.open_session'|trans }}">#{{ decision.sessionId|slice(0, 8) }}</a>
                {% endif %}
            </p>
        </div>
    </li>
{% endmacro %}

{#
    Entrées du journal groupées par jour. Variables : entries, filter, continued (true pour une page chargée après la première).
    Chaque en-tête de jour porte data-day pour que le chargement AJAX évite les doublons.
#}
{% import '_ui.html.twig' as ui %}
{% set current_day = null %}
{% for entry in entries %}
    {% set day = entry.createdAt|date('Y-m-d', app_timezone) %}
    {% if day != current_day %}
        {% set current_day = day %}
        <li data-day="{{ day }}" class="mb-3 {{ not loop.first or continued ? 'mt-6' }} text-label-md font-semibold uppercase tracking-wider text-on-surface-variant">{{ entry.createdAt|format_date('full') }}</li>
    {% endif %}
    {{ ui.activity_entry(entry, true, filter.terms) }}
{% endfor %}

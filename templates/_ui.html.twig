{# Composants d'interface. Import : {% import '_ui.html.twig' as ui %} #}

{% macro tone_classes(tone) -%}
    {{ {
        done: 'bg-done-soft text-done',
        progress: 'bg-progress-soft text-progress',
        review: 'bg-review-soft text-review',
        planned: 'bg-planned-soft text-planned',
        blocked: 'bg-blocked-soft text-blocked',
        muted: 'bg-muted-soft text-muted',
        primary: 'bg-primary-soft text-primary',
    }[tone] ?? 'bg-muted-soft text-muted' }}
{%- endmacro %}

{% macro bar_classes(tone) -%}
    {{ {done: 'bg-done', progress: 'bg-progress', review: 'bg-review', planned: 'bg-planned', blocked: 'bg-blocked', muted: 'bg-muted'}[tone] ?? 'bg-primary-container' }}
{%- endmacro %}

{# Pastille de statut : TicketStatus, PlanStatus ou ProjectStatus. #}
{% macro status(status) %}
    {% set t = tone(status) %}
    <span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2 py-0.5 text-label-sm font-semibold {{ _self.tone_classes(t) }}">
        <span class="size-1.5 rounded-full {{ _self.bar_classes(t) }}"></span>{{ status|trans }}
    </span>
{% endmacro %}

{% macro chip(label, tone = 'muted', icon = null, title = null) %}
    <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full px-2 py-0.5 text-label-sm font-semibold {{ _self.tone_classes(tone) }}" {% if title %}title="{{ title }}"{% endif %}>
        {%- if icon %}<span class="icon text-[14px]">{{ icon }}</span>{% endif %}{{ label -}}
    </span>
{% endmacro %}

{# Filtre actif, retirable. #}
{% macro filter_chip(label, clear_url, clear_label, icon = 'filter_alt') %}
    <span class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary-soft py-0.5 pl-2.5 pr-1 text-label-md font-semibold text-primary">
        <span class="icon text-[15px]">{{ icon }}</span>{{ label }}
        <a href="{{ clear_url }}" class="ml-0.5 flex size-5 items-center justify-center rounded-full hover:bg-primary/15" title="{{ clear_label }}" aria-label="{{ clear_label }}">
            <span class="icon text-[15px]">close</span>
        </a>
    </span>
{% endmacro %}

{% macro priority(priority) %}
    {% set cfg = {
        urgent: {tone: 'blocked', icon: 'priority_high'},
        high: {tone: 'progress', icon: 'keyboard_double_arrow_up'},
        medium: {tone: 'muted', icon: 'drag_handle'},
        low: {tone: 'muted', icon: 'keyboard_arrow_down'},
    }[priority.value] %}
    {{ _self.chip(priority|trans, cfg.tone, cfg.icon) }}
{% endmacro %}

{% macro risk(risk) %}
    {{ _self.chip(risk|trans, {low: 'done', medium: 'progress', high: 'blocked'}[risk.value]) }}
{% endmacro %}

{% macro progress(percent, tone = null, size = 'h-1.5') %}
    {% set t = tone ?? (percent >= 100 ? 'done' : 'primary') %}
    <div class="{{ size }} w-full overflow-hidden rounded-full bg-surface-high" role="progressbar" aria-valuenow="{{ percent }}" aria-valuemin="0" aria-valuemax="100">
        <div class="h-full rounded-full {{ _self.bar_classes(t) }}" style="width: {{ min(100, max(0, percent)) }}%"></div>
    </div>
{% endmacro %}

{% macro kpi(label, value, hint = null, icon = null, tone = null) %}
    <div class="card flex flex-col gap-1 p-4 {{ tone == 'blocked' ? 'border-blocked/40' }}">
        <div class="flex items-center justify-between text-label-md font-medium text-on-surface-variant">
            {{ label }}
            {% if icon %}<span class="icon text-[18px] {{ tone == 'blocked' ? 'text-blocked' : 'text-primary' }}">{{ icon }}</span>{% endif %}
        </div>
        <div class="font-display text-headline-lg font-bold {{ tone == 'blocked' ? 'text-blocked' }}">{{ value }}</div>
        {% if hint %}<div class="text-body-sm text-on-surface-variant">{{ hint }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro empty(title, text = null, icon = 'inbox') %}
    <div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-outline-variant px-6 py-10 text-center">
        <span class="icon text-[32px] text-outline">{{ icon }}</span>
        <p class="font-display text-headline-sm font-semibold">{{ title }}</p>
        {% if text %}<p class="max-w-md text-body-sm text-on-surface-variant">{{ text }}</p>{% endif %}
    </div>
{% endmacro %}

{# Ligne compacte d'un ticket (listes, arbres). #}
{% macro ticket_row(ticket) %}
    {% set sub = ticket.subTasks %}
    <a href="{{ path('ticket_show', {key: ticket.key}) }}" class="group flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-surface-low">
        <span class="key w-20 shrink-0">{{ ticket.key }}</span>
        <span class="min-w-0 flex-1 truncate {{ ticket.status.closed ? 'text-on-surface-variant line-through decoration-outline-variant' : '' }} group-hover:text-primary">{{ ticket.title }}</span>
        {% if ticket.blocked and ticket.status.value != 'blocked' and not ticket.status.closed %}
            {{ _self.chip('ticket.blocked_badge'|trans, 'blocked', 'block') }}
        {% endif %}
        {% if sub|length %}<span class="hidden text-label-md text-on-surface-variant sm:inline">{{ sub|filter(s => s.done)|length }}/{{ sub|length }}</span>{% endif %}
        <span class="hidden md:inline">{{ _self.priority(ticket.priority) }}</span>
        {{ _self.status(ticket.status) }}
    </a>
{% endmacro %}

{# Carte Kanban. #}
{% macro ticket_card(ticket, show_epic = true) %}
    {% set sub = ticket.subTasks %}
    {% set blockers = ticket.openBlockers %}
    <a href="{{ path('ticket_show', {key: ticket.key}) }}" class="card card-link flex flex-col gap-3 p-4 {{ ticket.blocked and not ticket.status.closed ? 'border-l-4 border-l-blocked' }}">
        <div class="flex items-center justify-between gap-2">
            <span class="key">{{ ticket.key }}</span>
            {{ _self.priority(ticket.priority) }}
        </div>
        <p class="font-semibold leading-snug text-on-surface">{{ ticket.title }}</p>
        {% if show_epic and ticket.epic %}
            <div>{{ _self.chip(ticket.epic.title, 'review') }}</div>
        {% endif %}
        {% if blockers|length and not ticket.status.closed %}
            <div class="flex flex-wrap gap-1">
                {% for b in blockers %}{{ _self.chip('ticket.blocked_by'|trans ~ ' ' ~ b.key, 'blocked', 'block') }}{% endfor %}
            </div>
        {% endif %}
        <div class="flex items-center gap-3 border-t border-outline-variant/40 pt-3 text-label-md text-on-surface-variant">
            {% if sub|length %}
                <span class="flex items-center gap-1"><span class="icon text-[16px]">check_box</span>{{ sub|filter(s => s.done)|length }}/{{ sub|length }}</span>
            {% endif %}
            {% if ticket.storyPoints is not null %}<span class="flex items-center gap-1"><span class="icon text-[16px]">bolt</span>{{ ticket.storyPoints }}</span>{% endif %}
            {% if ticket.links|length %}<span class="flex items-center gap-1"><span class="icon text-[16px]">link</span>{{ ticket.links|length }}</span>{% endif %}
            {% if ticket.status.value == 'done' and ticket.completedAt %}
                <span class="ml-auto flex items-center gap-1" title="{{ 'ticket.completed'|trans }} {{ ticket.completedAt|format_datetime('medium', 'short') }}"><span class="icon text-[16px] text-done">check_circle</span>{{ ticket.completedAt|ago }}</span>
            {% else %}
                <span class="ml-auto">{{ ticket.type|trans }}</span>
            {% endif %}
        </div>
    </a>
{% endmacro %}

{# Entrée du journal. #}
{# Libellé d'un événement du journal : « Ticket créé », « Statut : À faire → En cours », « Décision »… #}
{% macro activity_event(entry) -%}
    {%- set type = entry.type.value -%}
    {%- if type == 'created' -%}
        {{ 'activity.event.created'|trans({kind: entry.data.kind ?? 'ticket'}) }}
    {%- elseif type == 'status_changed' -%}
        {%- set kind = entry.data.kind ?? 'ticket' -%}
        {%- set prefix = kind == 'ticket' ? 'ticket_status.' : (kind == 'project' ? 'project_status.' : 'plan_status.') -%}
        {{ 'activity.event.status_changed'|trans({from: (prefix ~ entry.data.from)|trans, to: (prefix ~ entry.data.to)|trans}) }}
    {%- else -%}
        {{ entry.type|trans }}
    {%- endif -%}
{%- endmacro %}

{#
    Suite d'événements automatiques repliée (ActivityGrouper). Identifiée par sa plus ancienne entrée :
    l'id reste stable quand des événements s'ajoutent en haut, le rafraîchissement garde l'état ouvert/fermé.
#}
{% macro activity_group(item, terms = []) %}
    {% set entries = item.entries %}
    {% set newest = entries|first %}
    {% set oldest = entries|last %}
    <li id="activity-group-{{ oldest.id }}" data-entry-group class="group/g relative flex gap-3 pb-5 last:pb-0">
        <span class="absolute left-[15px] top-8 bottom-0 w-px bg-outline-variant/50 group-last/g:hidden"></span>
        <span class="relative flex size-8 shrink-0 items-center justify-center rounded-full bg-muted-soft text-muted group-has-[[data-new]]/g:ring-2 group-has-[[data-new]]/g:ring-primary group-has-[[data-new]]/g:ring-offset-2 group-has-[[data-new]]/g:ring-offset-surface-lowest">
            <span class="icon text-[17px]">stacks</span>
        </span>
        <details class="group/d min-w-0 flex-1 pt-1">
            <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-2 gap-y-1 rounded-md text-body-sm hover:text-primary">
                <span class="icon text-[18px] text-outline transition-transform group-open/d:rotate-90">chevron_right</span>
                <span class="font-semibold">{{ 'activity.group.title'|trans({count: entries|length}) }}</span>
                <span class="text-on-surface-variant">
                    {{- [
                        item.created ? 'activity.group.created'|trans({count: item.created}) : null,
                        item.statusChanged ? 'activity.group.status_changed'|trans({count: item.statusChanged}) : null,
                    ]|filter(v => v)|join(' · ') -}}
                </span>
                <span class="hidden rounded-full bg-primary-soft px-1.5 text-label-sm font-semibold text-primary group-has-[[data-new]]/g:inline">{{ 'activity.new.badge'|trans }}</span>
                <span class="ml-auto text-label-md text-outline">
                    <time datetime="{{ newest.createdAt|date('c') }}" title="{{ oldest.createdAt|format_datetime('medium', 'short') }} – {{ newest.createdAt|format_datetime('medium', 'short') }}">{{ newest.createdAt|ago }}</time>
                </span>
            </summary>
            <p class="mt-1 flex flex-wrap items-center gap-2 pl-6 text-label-md text-outline">
                <span>{{ 'activity.by'|trans({author: newest.author}) }}</span>
                {% if newest.sessionId %}
                    <a href="{{ path('session_show', {sessionId: newest.sessionId}) }}" class="font-mono hover:text-primary" title="{{ 'activity.open_session'|trans }}">#{{ newest.sessionId|slice(0, 8) }}</a>
                {% endif %}
            </p>
            <ol class="mt-2 flex flex-col gap-1 border-l border-outline-variant/60 pl-4">
                {% for entry in entries %}
                    <li data-entry="{{ entry.id }}" class="group flex min-w-0 flex-wrap items-baseline gap-x-2 text-body-sm">
                        {% if entry.ticket %}
                            <a href="{{ path('ticket_show', {key: entry.ticket.key}) }}" class="key hover:text-primary">{{ entry.subjectKey|highlight(terms) }}</a>
                        {% else %}
                            <a href="{{ path('project_show', {key: entry.project.key}) }}" class="key hover:text-primary">{{ entry.subjectKey|highlight(terms) }}</a>
                        {% endif %}
                        <span>{{ _self.activity_event(entry) }}</span>
                        {% if entry.type.value == 'created' and entry.data.title is defined %}
                            <span class="min-w-0 truncate text-on-surface-variant">{{ entry.data.title|highlight(terms) }}</span>
                        {% endif %}
                        <span class="hidden rounded-full bg-primary-soft px-1.5 text-label-sm font-semibold text-primary group-data-new:inline">{{ 'activity.new.badge'|trans }}</span>
                    </li>
                {% endfor %}
            </ol>
        </details>
    </li>
{% endmacro %}

{% macro activity_entry(entry, show_subject = true, terms = []) %}
    {% set type = entry.type.value %}
    {% set icon = {created: 'add_circle', status_changed: 'swap_horiz', note: 'sticky_note_2', decision: 'gavel', progress: 'trending_up', blocker: 'block', commit: 'commit', test: 'science'}[type] %}
    {% set tone = {blocker: 'blocked', decision: 'review', progress: 'progress', commit: 'primary', test: 'done'}[type] ?? 'muted' %}
    <li class="group relative flex gap-3 pb-5 last:pb-0" data-entry="{{ entry.id }}">
        <span class="absolute left-[15px] top-8 bottom-0 w-px bg-outline-variant/50 group-last:hidden"></span>
        <span class="relative flex size-8 shrink-0 items-center justify-center rounded-full group-data-new:ring-2 group-data-new:ring-primary group-data-new:ring-offset-2 group-data-new:ring-offset-surface-lowest {{ _self.tone_classes(tone) }}">
            <span class="icon text-[17px]">{{ icon }}</span>
        </span>
        <div class="min-w-0 flex-1 pt-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-body-sm">
                {% if show_subject %}
                    {% if entry.ticket %}
                        <a href="{{ path('ticket_show', {key: entry.ticket.key}) }}" class="key hover:text-primary">{{ entry.subjectKey|highlight(terms) }}</a>
                    {% else %}
                        <a href="{{ path('project_show', {key: entry.project.key}) }}" class="key hover:text-primary">{{ entry.subjectKey|highlight(terms) }}</a>
                    {% endif %}
                {% endif %}
                <span class="font-semibold">{{ _self.activity_event(entry) }}</span>
                {% if type == 'created' and entry.data.title is defined %}
                    <span class="truncate text-on-surface-variant">{{ entry.data.title|highlight(terms) }}</span>
                {% endif %}
                <span class="hidden rounded-full bg-primary-soft px-1.5 text-label-sm font-semibold text-primary group-data-new:inline">{{ 'activity.new.badge'|trans }}</span>
                <span class="ml-auto flex items-center gap-2 text-label-md text-outline">
                    <time datetime="{{ entry.createdAt|date('c') }}" title="{{ entry.createdAt|format_datetime('medium', 'short') }}">{{ entry.createdAt|ago }}</time>
                </span>
            </div>
            {% if entry.message %}
                <div class="prose-md mt-2 rounded-lg bg-surface-low px-3 py-2 text-body-sm">{{ entry.message|markdown|highlight(terms) }}</div>
            {% endif %}
            <div class="mt-1 flex flex-wrap items-center gap-2 text-label-md text-outline">
                <span>{{ 'activity.by'|trans({author: entry.author}) }}</span>
                {% if entry.sessionId %}
                    <a href="{{ path('session_show', {sessionId: entry.sessionId}) }}"
                       class="font-mono hover:text-primary" title="{{ 'activity.open_session'|trans }}">#{{ entry.sessionId|slice(0, 8) }}</a>
                {% endif %}
            </div>
        </div>
    </li>
{% endmacro %}

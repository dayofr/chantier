{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/hooks/chantier-session-start.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/hooks/chantier-stop.sh\"" }
        ]
      }
    ]
  }
}
